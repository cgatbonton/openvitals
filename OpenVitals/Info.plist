<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>UIAppFonts</key>
	<array>
		<string>Outfit-Variable.ttf</string>
		<string>IBMPlexSans-Variable.ttf</string>
		<string>IBMPlexMono-Regular.ttf</string>
		<string>IBMPlexMono-Medium.ttf</string>
	</array>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>OpenVitals</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.gatbontontech.openvitals.health</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>openvitals</string>
			</array>
		</dict>
	</array>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<true/>
		<key>NSExceptionDomains</key>
		<dict>
			<key>tail5f467f.ts.net</key>
			<dict>
				<key>NSExceptionAllowsInsecureHTTPLoads</key>
				<true/>
				<key>NSIncludesSubdomains</key>
				<true/>
			</dict>
		</dict>
	</dict>
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>OpenVitals uses Bluetooth to connect to your compatible user-owned BLE health device and read local device data.</string>
	<key>NSBluetoothPeripheralUsageDescription</key>
	<string>OpenVitals uses Bluetooth to connect to your compatible user-owned BLE health device and read local device data.</string>
	<key>NSHealthUpdateUsageDescription</key>
	<string>Development builds of OpenVitals write a small sample fixture into Apple Health to verify the Apple Watch upload path. The shipped app never asks to write to Health.</string>
	<key>NSHealthShareUsageDescription</key>
	<string>OpenVitals reads body mass to prefill your local profile. When you connect it to your own Health Command Center and turn on Apple Watch upload, it also reads the readings your Apple Watch recorded — heart-rate variability, resting and workout heart rate, breathing rate, blood oxygen, wrist temperature, VO2 max, steps, active energy, sleep stages and workouts — and uploads them to that server.</string>
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>OpenVitals uses background location to keep tracking outdoor workout routes, pace, and distance when you minimize the app.</string>
	<key>NSLocationAlwaysUsageDescription</key>
	<string>OpenVitals uses background location to keep tracking outdoor workout routes, pace, and distance when you minimize the app.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>OpenVitals uses location to record outdoor workout routes, pace, distance, and elevation.</string>
	<key>NSSupportsLiveActivities</key>
	<true/>
	<key>NSSupportsLiveActivitiesFrequentUpdates</key>
	<true/>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>UIBackgroundModes</key>
	<array>
		<string>bluetooth-central</string>
		<string>location</string>
		<string>fetch</string>
		<string>processing</string>
		<string>remote-notification</string>
	</array>
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>com.gatbontontech.openvitals.hcc.healthkit-upload</string>
		<string>com.gatbontontech.openvitals.hcc.refresh</string>
	</array>
	<key>NSAlarmKitUsageDescription</key>
	<string>Command Center schedules the wake alarm you set from your sleep plan.</string>
	<key>UIFileSharingEnabled</key>
	<true/>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
</dict>
</plist>
